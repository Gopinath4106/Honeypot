# Environment Configuration for Honeypot Attack Monitor
# Copy this file to .env for local overrides

FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=honeypot-insecure-dev-secret-key-change-in-production
DATABASE_PATH=instance/database.db
HONEYPOT_MODE=sample
HONEYPOT_LOG_PATH=honeypot/sample_logs/cowrie.sample.json
REPORTS_DIR=reports
